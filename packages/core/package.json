{
  "name": "@iron-proxy/core",
  "version": "0.2.0",
  "description": "Account switching engine for AI providers: titled profiles, ordered same-provider failover on quota signals, automatic return. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "anthropic",
    "openai",
    "gemini",
    "grok",
    "failover",
    "rate-limit",
    "electron",
    "proxy",
    "subscription"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RealDealCPA-VR/Iron-Proxy.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/RealDealCPA-VR/Iron-Proxy/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/Iron-Proxy/issues"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
