{
  "name": "@iron-proxy/core",
  "version": "0.1.0",
  "description": "Account switching engine for AI providers: titled profiles, ordered same-provider failover on quota signals, automatic return. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "anthropic",
    "openai",
    "gemini",
    "grok",
    "failover",
    "rate-limit",
    "electron",
    "proxy",
    "subscription"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RealDealCPA-VR/Iron-Proxy.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
