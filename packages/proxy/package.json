{
  "name": "@iron-proxy/proxy",
  "version": "0.2.0",
  "description": "Localhost proxy for Iron-Proxy: OpenAI- and Anthropic-compatible endpoints with account failover, plus a control API and an HTTP client. Zero runtime dependencies beyond @iron-proxy/core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@iron-proxy/core": "workspace:^"
  },
  "keywords": [
    "ai",
    "proxy",
    "openai-compatible",
    "anthropic-compatible",
    "failover",
    "rate-limit",
    "localhost",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RealDealCPA-VR/Iron-Proxy.git",
    "directory": "packages/proxy"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/RealDealCPA-VR/Iron-Proxy/tree/main/packages/proxy#readme",
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/Iron-Proxy/issues"
  }
}
